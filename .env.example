# Application
APP_NAME=SRK
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/retail_application

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=86400

# SendGrid Email Service
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
FROM_EMAIL=your_verified_sendgrid_sender@example.com

# SendGrid Template IDs
SENDGRID_OTP_TEMPLATE_ID=d-0d1da8571eef4693965293b5c1c97524
SENDGRID_RESET_PASSWORD_TEMPLATE_ID=d-your_reset_password_template_id

# Optional: Old SMTP settings (if you want to keep Gmail as backup)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_gmail@gmail.com
# SMTP_PASSWORD=your_app_password
